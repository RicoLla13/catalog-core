CONFIG_LIBINTERCEPT=y
CONFIG_LIBINTERCEPT_TRANSPORT_SOCKET=y
CONFIG_LIBINTERCEPT_REMOTE_IPV4="172.44.0.1"
CONFIG_LIBINTERCEPT_REMOTE_PORT=9999
# CONFIG_LIBINTERCEPT_CONNECT_ON_FIRST_RPC is not set
# CONFIG_LIBINTERCEPT_CONNECT_BOOT_BEST_EFFORT is not set
CONFIG_LIBINTERCEPT_CONNECT_BOOT_REQUIRED=y
CONFIG_LIBPOSIX_VFS_FSTAB=y
CONFIG_LIBPOSIX_VFS_FSTAB_USER=y
CONFIG_LIBLWIP=y
CONFIG_LIBUKRANDOM=y
CONFIG_LIBUKRANDOM_LCPU=y
CONFIG_LIBUKNETDEV_EINFO_LIBPARAM=y
CONFIG_LIBRAMFS=y
CONFIG_LIBUKCPIO=y

